# /etc/nginx/sites-available/alugridx  (certbot will add the 443 blocks)
# Canonical = https://alugridx.com (non-www). Keep ONE version only.
server {
    listen 80;
    server_name alugridx.com www.alugridx.com;
    return 301 https://alugridx.com$request_uri;
}
server {
    listen 443 ssl http2;
    server_name www.alugridx.com;
    # ssl_certificate ... (certbot)
    return 301 https://alugridx.com$request_uri;
}
server {
    listen 443 ssl http2;
    server_name alugridx.com;
    # ssl_certificate ... (certbot)
    client_max_body_size 11m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 35s;
    }
}
